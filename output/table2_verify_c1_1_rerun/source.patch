+class ContactPoseResolver(Protocol):
+    def resolve(
+        self,
+        patch: ToolContactPatch,
+        *,
+        contact_position_world_m: Sequence[float],
+        push_direction_world: Sequence[float],
+    ) -> Pose: ...
