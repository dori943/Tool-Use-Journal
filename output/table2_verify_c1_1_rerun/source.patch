-    def tool_clearance_summary(self) -> dict[str, object]:
-        """Evaluate controlled sweep clearance independently of grasp retention."""
-
-        controlled = [
-            sample
-            for sample in self.samples
-            if isinstance(sample.get("physical_tool_control"), Mapping)
