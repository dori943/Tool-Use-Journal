+
+def test_report_distinguishes_goal_not_evaluated_from_success(tmp_path):
+    write_json(
+        tmp_path / "run_result.json",
+        {
+            "success": True,
+            "exec_success": True,
+            "goal_success": None,
+            "failure_stage": "none",
+            "m5_status": "SUCCESS",
+            "task_goal_status": "NOT_EVALUATED",
+        },
