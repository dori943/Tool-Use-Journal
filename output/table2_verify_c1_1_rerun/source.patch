-    env = runtime.env
-    if object_id not in env.obj_body_id:  # type: ignore[attr-defined]
-        raise RuntimeError(f"physical grasp object {object_id!r} is absent")
-    data = env.sim.data._data  # type: ignore[attr-defined]
