+
+# --------------------------------------------------------------------------- #
+# Policy                                                                      #
+# --------------------------------------------------------------------------- #
+
+
+class MotionCosts(_ExtensibleModel):
+
+    move_to_tool_rack: int = Field(default=2, ge=0)
