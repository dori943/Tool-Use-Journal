+                    final_segment_validator, "__self__", None
+                )
+                last_check = getattr(
+                    validator_owner, "last_path_collision_check", None
+                )
+                if last_check is None:
+                    last_check = getattr(
+                        final_segment_validator,
+                        "last_path_collision_check",
+                        None,
+                    )
