+def _c2_1_class_of(inst):
+    if inst == "apple":  return "apple"
+    if inst == "bread":  return "bread"
+    if inst == "mug":    return "mug"
+    if inst == "plate":  return "plate"
+    if inst == "spoon":  return "spoon"
