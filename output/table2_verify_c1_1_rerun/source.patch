-def _wrapped_delta(left: Sequence[float], right: Sequence[float]) -> np.ndarray:
-    delta = np.asarray(left, dtype=float) - np.asarray(right, dtype=float)
-    return (delta + np.pi) % (2.0 * np.pi) - np.pi
