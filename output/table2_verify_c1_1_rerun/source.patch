-    def preshape_finger_gripper_to_aperture(
-        self,
-        *,
-        target_aperture_m: float,
-        tolerance_m: float = 0.002,
-        max_iterations: int = 30,
-        settle_ticks_per_iteration: int = 20,
-        final_settle_ticks: int = 25,
