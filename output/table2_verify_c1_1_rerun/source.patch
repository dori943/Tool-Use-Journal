+    rotation = Rotation.from_euler('z', 43., degrees=True)
+    delta = np.array([.23, -.17, 0.])
+    moved = request.model_copy(deep=True)
+    for record in moved.world.objects.values():
+        if 'pose' not in record:
+            continue
