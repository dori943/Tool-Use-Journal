+        if stage in stage_status:
+            stage_status[stage] = "failed"
+        elif stage == "greedy_assignment":
+            stage_status["greedy_assignment"] = "failed"
+        manifest["failure"] = {
+            "stage": stage,
+            "type": type(error).__name__,
