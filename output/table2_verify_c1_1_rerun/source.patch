-                upper += 2.0 * float(np.linalg.norm(self._model.jnt_pos[joint_id]))
-                if joint_type == int(mujoco.mjtJoint.mjJNT_SLIDE):
-                    lower, higher = self._model.jnt_range[joint_id]
-                    upper += max(abs(float(lower)), abs(float(higher)))
