+            "m1_feasible": m1_feasible,
+            "registry_production": reg["production"],
+            "registry_experimental": reg["experimental"],
+            "gap_gt_feasible_but_no_recipe": gap,
+            "recipe_but_gt_infeasible": unsafe,
