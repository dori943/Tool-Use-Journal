+    return {
+        "task": task,
+        "m2_subgoals": subgoals,
+        "m2_semantic_corrections": corrections,
+        "m2_partial_order": edges,
+        "m2_mutex": mutex,
+        "m2_invariants": invariants_for(subgoals),
