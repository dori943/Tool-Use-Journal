+class CountingBackend(MockBackend):
+    def __init__(self):
+        self.calls = 0
+
+    def estimate(self, crop_rgb, cls_hint, points_mm=None):
+        self.calls += 1
+        return super().estimate(crop_rgb, cls_hint, points_mm)
