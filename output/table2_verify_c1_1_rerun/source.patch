-            {
-                "source_artifact_id": raw.artifact_id,
-                "bound_frames": bound_frame_payload,
-            },
-            sort_keys=True,
-        ).encode("utf-8")
-    ).hexdigest()[:16]
-    return raw.model_copy(
-        update={
-            "artifact_id": f"{raw.artifact_id}:task-geometry:{digest}",
-            "provenance": raw.provenance.model_copy(
