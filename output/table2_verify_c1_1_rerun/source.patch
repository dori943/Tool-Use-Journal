+    for var, val in sorted(binding.items(), key=lambda kv: -len(kv[0])):
+        expr = expr.replace(var, str(val))
+    head = template.split("(")[0]
+    return {"id": f"{sid}_{kind}{i}", "expr": expr,
+            "head": head, "eval_by": EVAL_BY[head]}
