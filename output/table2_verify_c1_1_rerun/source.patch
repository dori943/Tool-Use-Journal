+    # 선택 결과가 없는 경로(TemplateRough 테스트)만 판정 사양에서 파생해 채운다.
+    for s in subgoals:
+        if "object_ids" not in s:
+            s["object_ids"] = object_ids_of(s, m1_serialized)
