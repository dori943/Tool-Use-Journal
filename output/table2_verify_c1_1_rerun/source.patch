+                       preshape_aperture_m=SIZES[object_id][1]+.012,
+                       preshape_closure_command=-.55)
+    # Open 3F enclosure, centered at the upper surface of each slab.
+    return replace(base, offset_fraction=(0.,0.,.5), preshape_closure_command=0.)
