-    args, depth, cur = [], 0, ""
-    for ch in inner:
-        if ch == "{":
-            depth += 1; cur += ch
-        elif ch == "}":
-            depth -= 1; cur += ch
-        elif ch == "," and depth == 0:
-            args.append(cur); cur = ""
-        else:
-            cur += ch
-    if cur.strip():
