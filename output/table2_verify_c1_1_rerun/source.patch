-    margin = placement_margin_m()
-    cz = float(container["center_mm"][2])
-    floor_mm = cz - float(container["bbox_mm"][2]) / 2.0 + _CONTAINER_FLOOR_MM
-    by_id = {m["id"]: m for m in members}
-    per_slot, blocked = {}, []
-    for oid, slot in layout["slots"].items():
