+def test_measured_faces_do_not_fill_holes_between_components():
+    import pytest
+    from tuj.m5_motion.flatten_contact import contact_face_center, measured_contact_face
+    boxes = [np.asarray(list(product(x, y, [-.005, .005]))) for x, y in
