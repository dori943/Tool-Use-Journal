+        "detail_id": sid,
+        "action_type": action,
+        "binding": binding,
+        "group_id": group,
+        "note": note,
+        "pre": [_cond(sid, i, "p", t, binding) for i, t in enumerate(pre_t)],
+        "establish": [_cond(sid, i, "e", t, binding) for i, t in enumerate(est_t)],
+        "destroy": [_cond(sid, i, "d", t, binding) for i, t in enumerate(des_t)],
+    }
