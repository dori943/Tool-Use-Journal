+            )
+        )
+
+        self.object_placements = {}
+
+        for (
+            name,
+            (
+                x,
+                y,
+                yaw,
+            ),
+        ) in INITIAL_LAYOUT.items():
+
+            obj = self.objects[
+                name
+            ]
+
+            pos = (
+                *(
+                    self._layout_origin
+                    + [x, y]
+                ),
+                self._island_surface_z
+                - float(
+                    obj.bottom_offset[2]
+                )
+                + 0.001,
+            )
+
+            quat = np.array(
+                [
+                    np.cos(
+                        yaw / 2
+                    ),
+                    0.0,
+                    0.0,
+                    np.sin(
+                        yaw / 2
+                    ),
+                ]
+            )
+
+            self.object_placements[
+                name
+            ] = (
+                pos,
+                quat,
+                obj,
+            )
+
+
+    def _reset_internal(self):
+
+        ManipulationEnv._reset_internal(
