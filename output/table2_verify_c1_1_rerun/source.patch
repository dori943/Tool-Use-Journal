+            body_in_tcp = _quaternion_matrix_xyzw(grasp.orientation_in_reference_xyzw)
+            points = np.asarray(record.get("collision_points_m", []), dtype=float)
+            if (points.ndim != 2 or points.shape[1:] != (3,) or len(points) < 4
