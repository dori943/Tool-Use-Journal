+
+    return {
+        name: {
+            "length_m": length,
+            "fits_axis_aligned": bool(
+                length <= axis_limit
+            ),
+            "fits_diagonal_bound": bool(
+                length <= BOX_DIAGONAL
+            ),
+        }
+        for name, length in OBJECT_LENGTHS.items()
+    }
