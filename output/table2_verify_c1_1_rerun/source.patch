+class _CountingPlanner:
+    def __init__(
+        self,
+        *,
+        result: EdgePlanResult,
+        tag: str,
+    ) -> None:
+        self.result = result
+        self.tag = tag
+        self.calls: list[
+            tuple[
+                RelativeKeyframeSpec | None,
+                RelativeKeyframeSpec,
+            ]
+        ] = []
+
+    def plan(self, source, target, source_keyframe, target_keyframe):
+        del source, target
+        self.calls.append((source_keyframe, target_keyframe))
+        return self.result
+
