-        for mesh in obj.asset.findall("mesh"):
-            scale = [float(v) for v in mesh.get("scale", "1 1 1").split()]
-            scale[mesh_axis] *= ratio
-            mesh.set("scale", " ".join(f"{v:.12g}" for v in scale))
