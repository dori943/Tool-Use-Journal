+def test_geometry_is_current_rejects_non_finite_ee_fields():
+    from tuj.m1_scene.grounding import geometry_is_current
+
+    base = _props()["geometry"]
+
+    assert geometry_is_current(base)
+
+    for bad in (
+        None,
+        float("nan"),
+        float("inf"),
+        float("-inf"),
+    ):
