-def build_targets_for_entry(
-    entry: GraspEntry,
-    T_WB: np.ndarray,
-    center_in_body_m: np.ndarray,
-    local_size_m: np.ndarray,
-):
-    """Call the object module's target builder; fall back to catalog/spoon."""
