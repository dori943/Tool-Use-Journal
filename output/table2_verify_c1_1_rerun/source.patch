+from __future__ import annotations
+
+import pytest
+
+from tuj.m5_motion.phase_contract import (
+    KeyframePhaseContractError,
+    validate_keyframe_phase_contract,
+)
+from tuj.m5_motion.schema import (
+    ArtifactProvenance,
+    GoalType,
+    KeyframeEventType,
