+        for name in ("qpos", "qvel", "ctrl"):
+            destination = getattr(data, name)
+            source = np.asarray(saved[name], dtype=float)
+            if destination.shape != source.shape:
+                raise ValueError(
+                    f"saved {name} shape {source.shape} != runtime {destination.shape}"
+                )
