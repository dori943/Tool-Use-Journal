+            "n_details": len(all_details),
+            "n_edges": len(edges),
+            "n_mutex": len(mutex),
+            # 단계별 LLM 토큰 (0828 — Fig1 token 그래프, 호출 통합 A/B 근거)
+            "llm_usage": getattr(rough, "usage", {}),
+        },
+    }
