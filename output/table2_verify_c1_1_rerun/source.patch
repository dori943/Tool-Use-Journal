-    @staticmethod
-    def _yaw_quat_wxyz(yaw):
-        quat_xyzw = T.mat2quat(
-            T.euler2mat(
-                np.array(
-                    [0.0, 0.0, float(yaw)]
-                )
-            )
-        )
-
-        return np.array(
