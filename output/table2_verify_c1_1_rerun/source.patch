-    @staticmethod
-    def _compute_c1_work_origin(bounds):
-        """Compute the same work origin used by the existing C4 scene."""
-
-        work_y = float(
-            bounds["center_xy"][1]
-        )
-
-        min_layout_x = min(
-            float(xy[0])
-            for xy in EE_RACK_LAYOUT.values()
-        )
-
-        edge = 0.04
-        gap = 0.05
-
-        work_x_lo = float(
-            bounds["xmin"]
-            + edge
-            - min_layout_x
-        )
-
-        work_x_hi = float(
-            bounds["xmin"]
-            - gap
-            - PEDESTAL_HALF_XY[0]
-            - ROBOT_BASE_X
-        )
-
-        if work_x_lo <= work_x_hi:
-            work_x = 0.5 * (
-                work_x_lo
-                + work_x_hi
-            )
-        else:
-            work_x = work_x_lo
-
-        work_origin = np.array(
-            [
-                work_x,
-                work_y,
-            ],
-            dtype=float,
-        )
-
-        robot_xy = (
-            work_origin
-            + np.array(
-                [
-                    ROBOT_BASE_X,
-                    0.0,
-                ],
-                dtype=float,
-            )
-        )
-
-        return (
-            work_origin,
-            robot_xy,
-            0.0,
-        )
