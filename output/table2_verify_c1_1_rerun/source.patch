-def _waypoint(time_s: float, position: float) -> TrajectoryWaypoint:
-    return TrajectoryWaypoint(
-        time_from_start_s=time_s,
-        joint_positions_rad=[position] * 6,
-        joint_velocities_rad_s=[0.0] * 6,
-        joint_accelerations_rad_s2=[0.0] * 6,
-    )
