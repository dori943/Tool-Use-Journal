+            request.world.robot_state.gripper.model_copy(deep=True)
+            if request.world.robot_state.gripper is not None
+            else GripperState()
+        )
+        clock = 0.0
+        continuous_joint_reference = tuple(
+            float(value)
+            for value in request.world.robot_state.joint_positions_rad
