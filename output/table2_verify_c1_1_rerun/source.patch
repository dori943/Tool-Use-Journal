-def canonicalize_sweep_lateral_toward_region(
-    request: MotionPlanRequest,
-    keyframes: Sequence[RelativeKeyframeSpec],
-    *,
-    resolver: RelativePoseResolver | None = None,
-) -> list[RelativeKeyframeSpec]:
-    """Rewrite CONTACT path so a rigid herd translation fits targets in-region.
-
-    VLMs often emit CONTACT_START/SWEEP/END on the same target top (zero lateral
-    travel), or a straight start→region-center line that leaves offset targets
-    outside the goal AABB. Compute a generic XY translation that maps the
-    target-cluster AABB into the goal-region AABB, then distribute SWEEP/END
-    along that displacement. When the translation has a large cross-track
-    component, herd that component first (still far from the region) before
-    pushing into the region — avoids dragging the whole cluster past distractors
-    beside the goal while still being task-id agnostic.
-    """
-
-    if not is_tool_act_contact_geometry_scope(request) or not keyframes:
-        return list(keyframes)
-    region_xy = _goal_region_center_xy_m(request)
-    if region_xy is None:
-        return list(keyframes)
-
-    active_resolver = resolver or RelativePoseResolver(request.world)
-    keyframes = [canonicalize_held_tool_orientation_for_contact(
-        request, keyframe, resolver=active_resolver
-    ) for keyframe in keyframes]
-    start_index = next(
-        (
-            index
-            for index, keyframe in enumerate(keyframes)
-            if keyframe.keyframe_type is KeyframeType.CONTACT_START
-        ),
-        None,
-    )
-    if start_index is None:
-        return list(keyframes)
-    try:
-        start_pose = active_resolver.resolve(keyframes[start_index])
-    except GeometryResolutionError:
-        return list(keyframes)
-    start_xy = _sweep_contact_xy(request, start_pose)
-    start_z = float(start_pose.position_m[2])
-
-    translation = _translation_to_fit_targets_in_region(request)
-    if translation is None:
-        translation = np.asarray(region_xy, dtype=float) - start_xy
-    # Bound the engaging patch, not the offset TCP, along the inbound axis.
-    # Full AABB-fit translations often overshoot into distractors that sit on
-    # the far side of the goal (utensils, fixtures). Keep the cross-track
-    # (herd) component so offset targets still enter the region AABB.
-    translation = _clamp_herd_translation_to_region_approach(
-        start_xy, region_xy, translation
-    )
-    dist = float(np.linalg.norm(translation))
-    if not math.isfinite(dist) or dist < _MIN_SWEEP_LATERAL_M:
-        return list(keyframes)
-
-    path_points = _sweep_herd_path_points(start_xy, translation, region_xy)
-    path_end = path_points[-1]
-    path_poly = [start_xy, *path_points]
-
-    end_index = next(
-        (
-            index
-            for index, keyframe in enumerate(keyframes)
-            if keyframe.keyframe_type is KeyframeType.CONTACT_END
-        ),
-        None,
-    )
-    if end_index is None:
-        return list(keyframes)
-    try:
-        end_pose = active_resolver.resolve(keyframes[end_index])
-    except GeometryResolutionError:
-        return list(keyframes)
-    end_xy = _sweep_contact_xy(request, end_pose)
-    engagement = _contact_engagement_tcp_z_m(
-        request, eef_orientation_xyzw=start_pose.orientation_xyzw
-    )
-    contact_z = (
-        float(engagement) if engagement is not None else float(start_z)
-    )
-    # Prefer the already-canonicalized CONTACT_START height when it is near
-    # engagement (start may include shallow press).
-    if abs(float(start_z) - contact_z) <= 0.02:
-        contact_z = float(start_z)
-
-    if float(np.linalg.norm(end_xy - path_end)) <= _SWEEP_CORRIDOR_DEVIATION_M:
-        corridor_ok = True
-        for keyframe in keyframes:
-            if keyframe.keyframe_type is not KeyframeType.CONTACT_SWEEP:
-                continue
-            try:
-                sweep_pose = active_resolver.resolve(keyframe)
-            except GeometryResolutionError:
-                corridor_ok = False
-                break
-            sweep_xy = _sweep_contact_xy(request, sweep_pose)
-            if (
-                _distance_to_polyline_m(sweep_xy, path_poly)
-                > _SWEEP_CORRIDOR_DEVIATION_M
-            ):
-                corridor_ok = False
-                break
-            sweep_z = _contact_engagement_tcp_z_m(
-                request, eef_orientation_xyzw=sweep_pose.orientation_xyzw
-            )
-            if abs(float(sweep_pose.position_m[2]) - (
-                contact_z if sweep_z is None else sweep_z
-            )) > 1e-3:
-                corridor_ok = False
-                break
-        end_z = _contact_engagement_tcp_z_m(
-            request, eef_orientation_xyzw=end_pose.orientation_xyzw
-        )
-        if abs(float(end_pose.position_m[2]) - (
-            contact_z if end_z is None else end_z
-        )) > 1e-3:
-            corridor_ok = False
-        if corridor_ok:
-            return list(keyframes)
-
-    move_indices = [
-        index
-        for index, keyframe in enumerate(keyframes)
-        if keyframe.keyframe_type
-        in {KeyframeType.CONTACT_SWEEP, KeyframeType.CONTACT_END}
-    ]
-    if not move_indices:
-        return list(keyframes)
-
-    sample_xy = _sample_polyline_by_fraction(path_poly, len(move_indices))
-    result = list(keyframes)
-    for index, target_xy in zip(move_indices, sample_xy):
-        try:
-            packing = active_resolver.resolve(result[index]).orientation_xyzw
-        except GeometryResolutionError:
-            continue
-        candidate_z = _contact_engagement_tcp_z_m(
-            request, eef_orientation_xyzw=packing
-        )
-        retargeted = _retarget_tcp_world_xy(
-            result[index],
-            resolver=active_resolver,
-            target_xy=target_xy - _held_tool_sweep_contact_xy_offset_m(
-                request, eef_orientation_xyzw=packing
-            ),
-            target_z=contact_z if candidate_z is None else candidate_z,
-            packing_xyzw=packing,
-            metadata_flag="sweep_lateral_canonicalized",
-        )
-        if retargeted is not None:
-            meta = {
-                **retargeted.metadata,
-                "sweep_herd_translation_m": [
-                    float(translation[0]),
-                    float(translation[1]),
-                ],
-            }
-            result[index] = retargeted.model_copy(update={"metadata": meta})
-
-    # Keep RETREAT above the final contact XY so withdraw does not fly back
-    # over the pre-sweep cluster.
-    try:
-        end_pose = active_resolver.resolve(result[end_index])
-        end_xy = _sweep_contact_xy(request, end_pose)
-        end_z = float(end_pose.position_m[2])
-    except GeometryResolutionError:
-        return result
-    hover_z = _hover_working_floor_z_m(request)
-    if hover_z is None:
-        hover_z = end_z + _HOVER_MIN_ABOVE_SUPPORT_M
-    hover_z = max(float(hover_z), end_z + _HOVER_MIN_ABOVE_SUPPORT_M)
-    for index, keyframe in enumerate(result):
-        if keyframe.keyframe_type is not KeyframeType.RETREAT:
-            continue
-        try:
-            packing_retreat = active_resolver.resolve(keyframe).orientation_xyzw
-        except GeometryResolutionError:
-            continue
-        retargeted = _retarget_tcp_world_xy(
-            keyframe,
-            resolver=active_resolver,
-            target_xy=end_xy - _held_tool_sweep_contact_xy_offset_m(
-                request, eef_orientation_xyzw=packing_retreat
-            ),
-            target_z=hover_z,
-            packing_xyzw=packing_retreat,
-            metadata_flag="sweep_lateral_retreat_follow",
-        )
-        if retargeted is not None:
-            result[index] = retargeted
-    return result
