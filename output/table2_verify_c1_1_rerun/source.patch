+            [-0.01, 0.0, recessed_z],
+            [0.0, 0.01, recessed_z],
+            [0.0, -0.01, recessed_z],
+            # Rim vertices that define a taller AABB than the cup footprint.
+            [0.05, 0.05, half_z],
+            [-0.05, 0.05, half_z],
+            [0.05, -0.05, half_z],
+            [-0.05, -0.05, half_z],
+            [0.0, 0.0, -half_z],
+        ],
+    )
+    artifact = _artifact(
