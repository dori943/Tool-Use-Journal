+def target_resting_on_region(
+    world: WorldSnapshot,
+    *,
+    target_id: str,
+    region_id: str,
+    horizontal_tolerance_m: float = 0.0,
+    maximum_gap_m: float = .005,
+    maximum_penetration_m: float = .005,
