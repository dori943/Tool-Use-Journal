+        calls.append(transform(position, quaternion_xyzw=quaternion))
+        return NS(solutions=[NS(qpos=np.zeros(6))])
+    c = NS(body_pose=lambda: initial.T_WB.copy(), grip_pose=lambda: initial.T_WE.copy(),
