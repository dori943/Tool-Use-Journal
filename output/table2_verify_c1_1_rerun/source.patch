-def _free_camera_intrinsic(h: int, w: int, fovy: float) -> np.ndarray:
-    """Free camera intrinsic matrix."""
-    f = 0.5 * h / np.tan(np.radians(fovy) / 2)
-    return np.array([[f, 0, w / 2], [0, f, h / 2], [0, 0, 1]])
