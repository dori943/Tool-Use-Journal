-def _quaternion_angle(left: Sequence[float], right: Sequence[float]) -> float:
-    a = np.asarray(left, dtype=float)
-    b = np.asarray(right, dtype=float)
-    a /= np.linalg.norm(a)
-    b /= np.linalg.norm(b)
-    return 2.0 * math.acos(float(np.clip(abs(np.dot(a, b)), 0.0, 1.0)))
