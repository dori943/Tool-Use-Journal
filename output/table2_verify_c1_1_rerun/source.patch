+        m1 = json.loads(m1_path.read_text(encoding="utf-8"))
+        for n in m1.get("nodes", []):
+            nid = n.get("id", "")
+            cls = n.get("class", "")
+            short = nid[len(f"obj_{cls}_"):] if nid.startswith(f"obj_{cls}_") else nid
+            m1_nodes[short] = n
