+    def _xy_size(
+        self,
+        name,
+    ):
+
+        bid = (
+            self.sim.model
+            .body_name2id(
+                self.objects[
+                    name
+                ].root_body
+            )
+        )
+
+        lo, hi = body_aabb(
+            self.sim,
+            bid,
+        )
+
+        return np.asarray(
+            hi[:2]
+            - lo[:2],
+            dtype=float,
+        )
