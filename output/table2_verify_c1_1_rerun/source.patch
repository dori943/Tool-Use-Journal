+    assert evaluate_container_settle(config,poses,deepcopy(poses))['succeeded']
+
+
+@pytest.mark.parametrize('missing', [['new'], ['prior'], ['box'], ['box', 'new', 'prior']])
+def test_missing_current_pose_cannot_reuse_starting_geometry(missing):
