-
-        pts = np.asarray(
-            self.island.get_bbox_points(),
-            dtype=float,
-        )
-
-        bounds = {
-            "xmin": float(
-                pts[:, 0].min()
-            ),
-            "xmax": float(
-                pts[:, 0].max()
-            ),
-            "ymin": float(
-                pts[:, 1].min()
-            ),
-            "ymax": float(
-                pts[:, 1].max()
-            ),
-            "zmin": float(
-                pts[:, 2].min()
-            ),
-            "zmax": float(
-                pts[:, 2].max()
-            ),
-            "center_xy": np.array(
-                [
-                    0.5
-                    * (
-                        pts[:, 0].min()
-                        + pts[:, 0].max()
-                    ),
-                    0.5
-                    * (
-                        pts[:, 1].min()
-                        + pts[:, 1].max()
