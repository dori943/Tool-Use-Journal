+def _nearest_alignment_variant_index(
+    profile: _C1MotionProfile, selected_blend: float
+) -> int:
+    blends = _sweep_alignment_blends(profile)
+    return min(
+        range(len(blends)),
+        key=lambda index: abs(blends[index] - selected_blend),
+    )
