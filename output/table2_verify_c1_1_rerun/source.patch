-        if tool_id is None:
-            return []
-        try:
-            body_id, _, _ = self._object_free_joint(self.env, tool_id)
-        except ToolUseJournalRuntimeError:
-            return []
-        fill_ids = self._held_tool_inactive_fill_geom_ids(body_id)
-        if not fill_ids:
-            return []
-        model, data = _raw_model_data(self.env)
