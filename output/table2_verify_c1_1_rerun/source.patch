+    planning_policy: PlanningPolicy = Field(default_factory=PlanningPolicy)
+
+
+# --------------------------------------------------------------------------- #
+# Replanning inputs                                                           #
+# --------------------------------------------------------------------------- #
+
+
+class ExecutionState(_ExtensibleModel):
