-            chain: set[int] = set()
-            body_id = self._eef_id
-            while body_id > 0:
-                chain.add(body_id)
-                body_id = int(self._model.body_parentid[body_id])
-            upper = float(np.linalg.norm(self._target_position_in_eef))
-            upper += sum(
-                float(np.linalg.norm(self._model.body_pos[item]))
-                for item in chain
