+        DeprecationWarning, stacklevel=2)
+
+_ALIASES = {
+    "FrictionHead": ("tuj.m1_scene.grounding", "FrictionHead"),
+    "MockBackend":  ("tuj.m1_scene.grounding", "MockBackend"),
+    "PropertyBackend": ("tuj.m1_scene.grounding", "PropertyBackend"),
