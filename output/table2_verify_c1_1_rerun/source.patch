+                np.inf,
+                np.inf,
+            ]
+        )
+
+        max_xyz = np.array(
+            [
+                -np.inf,
+                -np.inf,
+                -np.inf,
+            ]
+        )
+
+        for geom_id in geom_ids:
+
+            geom_pos = (
+                env.sim.data.geom_xpos[
