+def _openai_artifact(
+    request: MotionPlanRequest,
+    *,
+    model: str,
+    candidates: int,
+    cache_dir: Path,
+) -> KeyframePlanArtifact:
+    config = OpenAIKeyframeProviderConfig.from_environment(
+        model=model,
