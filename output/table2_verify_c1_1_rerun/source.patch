-            raw_status = str(validation.get("status") or "").upper()
-            if raw_status in {"SUCCESS", "SATISFIED"}:
-                status = GoalEvaluationStatus.SATISFIED
-            elif raw_status in {"FAILED", "FAILURE"}:
