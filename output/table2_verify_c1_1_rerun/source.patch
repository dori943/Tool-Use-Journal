+        free_joint_name="whisk_free",
+        reference_kind="body",
+        reference_name="robot0_right_hand",
+        position_in_reference_m=(0.1, 0.0, 0.0),
+        orientation_in_reference_xyzw=(0.0, 0.0, half_sqrt, half_sqrt),
