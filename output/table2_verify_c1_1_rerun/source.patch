-                    ),
-                    "metadata": {
-                        **raw.provenance.metadata,
-                        "geometry_binder": "TASK_GEOMETRY_KEYFRAME_BINDER_V1",
-                        "source_keyframe_artifact_id": raw.artifact_id,
-                        "bound_frame_count": len(bound_frame_payload),
