+    except BaseException as exc:
+        manifest["stages"][stage] = "failed"
+        if stage in stage_status:
+            stage_status[stage] = "failed"
+        manifest["failure"] = {"stage": stage, "type": type(exc).__name__, "message": str(exc)[:800],
