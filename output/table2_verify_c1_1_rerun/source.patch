+    assert kept[0].metadata["provided_suitability_score"] == 0.9
+    assert any(
+        rejection.reason_code is ReasonCode.SCORE_BELOW_THRESHOLD
+        and rejection.candidate_id == "S1-low"
+        for rejection in rejections
+    )
