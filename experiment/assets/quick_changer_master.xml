<!--
  Quick Changer - ROBOT SIDE MASTER (geometric placeholder)
  ============================================================================
  [중요 / IMPORTANT]
  이 저장소에는 원래 "Quick Changer Master" 모델이 존재하지 않는다(조사 결과).
  기존 파일을 수정하지 않기 위해, 로봇 손목에 장착할 "로봇 측 Master"를
  표현하는 최소 기하 플레이스홀더를 *새 파일*로만 추가했다.

  This repository does NOT ship a real "Quick Changer Master" model. To avoid
  editing any existing file, this is a NEW, self-contained geometric placeholder
  that represents ONLY the robot-side master coupling face on the wrist.

  범위 제약(요구사항 8/17)에 따라 실제 체결 구조(latch/pin/자석/공압)는 넣지
  않는다. 순수 시각/충돌 기하 + robosuite GripperModel 규약(root body + "eef"
  body + 표준 site/sensor)만 지킨다. 액추에이터/조인트가 없으므로 dof = 0 이고
  로봇 action space 에는 그리퍼 채널이 추가되지 않는다.

  Local +z = 손목 플랜지(z=0)에서 EE 결합 방향(바깥쪽)으로 뻗는 축.
  Local +z is the outward coupling direction away from the wrist flange (z=0).
-->
<mujoco model="quick_changer_master">
    <worldbody>
        <body name="qc_master_base" pos="0 0 0">
            <!-- robosuite 표준 힘/토크 센서 프레임 -->
            <site name="ft_frame" pos="0 0 0" size="0.01" rgba="1 0 0 1" type="sphere" group="1"/>
            <inertial pos="0 0 0.018" mass="0.25" diaginertia="4e-4 4e-4 4e-4"/>

            <!-- ===== OUTER MODEL (외형) : 로봇 측 마스터 플레이트 + 결합 보스 ===== -->
            <!-- 마스터 플레이트(플랜지에 붙는 원판). 시각 + 충돌. -->
            <geom name="qc_plate" type="cylinder" size="0.045 0.011" pos="0 0 0.011"
                  rgba="0.30 0.34 0.40 1" group="0" contype="1" conaffinity="1"/>
            <geom name="qc_plate_vis" type="cylinder" size="0.045 0.011" pos="0 0 0.011"
                  rgba="0.30 0.34 0.40 1" group="1" contype="0" conaffinity="0"/>
            <!-- 결합 보스(수 커플러, EE 측과 맞물릴 면). 시각 + 충돌. -->
            <geom name="qc_boss" type="cylinder" size="0.026 0.007" pos="0 0 0.029"
                  rgba="0.55 0.60 0.66 1" group="0" contype="1" conaffinity="1"/>
            <geom name="qc_boss_vis" type="cylinder" size="0.026 0.007" pos="0 0 0.029"
                  rgba="0.55 0.60 0.66 1" group="1" contype="0" conaffinity="0"/>
            <!-- 정렬 키(방향 표시용 작은 돌기). 시각용. -->
            <geom name="qc_key_vis" type="box" size="0.006 0.010 0.006" pos="0.020 0 0.029"
                  rgba="0.9 0.7 0.2 1" group="1" contype="0" conaffinity="0"/>

            <!-- 결합 인터페이스 면 = EE 가 도킹할 면. 이름은 반드시 "eef". -->
            <body name="eef" pos="0 0 0.036" quat="0.707105 0 0 -0.707105">
                <site name="grip_site" pos="0 0 0" size="0.01" rgba="1 0 0 0.5" type="sphere" group="1"/>
                <site name="ee_x" pos="0.1 0 0" size="0.005 .1" quat="0.707105 0 0.707108 0" rgba="1 0 0 0" type="cylinder" group="1"/>
                <site name="ee_y" pos="0 0.1 0" size="0.005 .1" quat="0.707105 0.707108 0 0" rgba="0 1 0 0" type="cylinder" group="1"/>
                <site name="ee_z" pos="0 0 0.1" size="0.005 .1" quat="1 0 0 0" rgba="0 0 1 0" type="cylinder" group="1"/>
                <site name="grip_site_cylinder" pos="0 0 0" size="0.005 10" rgba="0 1 0 0.3" type="cylinder" group="1"/>
            </body>
        </body>
    </worldbody>

    <sensor>
        <force name="force_ee" site="ft_frame"/>
        <torque name="torque_ee" site="ft_frame"/>
    </sensor>
</mujoco>
